#!/bin/sh
# reinsdev launcher (macOS / Linux / Git Bash on Windows).
HERE=$(cd "$(dirname "$0")" && pwd)
for PY in python3 python; do
  if command -v "$PY" >/dev/null 2>&1 &&
     "$PY" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1; then
    exec "$PY" "$HERE/reinsdev.py" "$@"
  fi
done
if command -v py >/dev/null 2>&1; then
  exec py -3 "$HERE/reinsdev.py" "$@"
fi
echo "reinsdev: Python 3.8+ not found" >&2
exit 1
