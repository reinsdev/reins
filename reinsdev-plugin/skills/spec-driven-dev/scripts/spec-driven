#!/bin/sh
# Reins CLI launcher (macOS / Linux / Git Bash on Windows).
HERE=$(cd "$(dirname "$0")" && pwd)
for PY in python3 python; do
  if command -v "$PY" >/dev/null 2>&1 &&
     "$PY" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1; then
    exec "$PY" "$HERE/spec-driven.py" "$@"
  fi
done
if command -v py >/dev/null 2>&1; then
  exec py -3 "$HERE/spec-driven.py" "$@"
fi
echo "reins: Python 3.8+ not found" >&2
if [ "$1" = "hook" ]; then exit 0; fi
exit 1
