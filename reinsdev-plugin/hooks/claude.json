{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/spec-driven-dev/scripts/spec-driven\" hook pre-tool --runtime claude"
          }
        ],
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/spec-driven-dev/scripts/spec-driven\" hook prompt-submit --runtime claude"
          }
        ]
      }
    ]
  }
}
